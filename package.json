{
  "name": "agentic-selling",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test packages/*/test/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "intake": "node --env-file-if-exists=.env packages/agents/src/cli/intake.ts",
    "photos": "node --env-file-if-exists=.env packages/agents/src/cli/photos.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
