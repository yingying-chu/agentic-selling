# Filled in by `shopify app dev` locally; set these in Vercel for production.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.vercel.app
SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations,write_publications

# Postgres (Neon from the Vercel Marketplace, or local: postgresql://localhost:5432/agentic_selling)
DATABASE_URL=

# Server-side AI for the "Write listings with AI" button. Vercel AI Gateway key,
# or leave empty and set ANTHROPIC_API_KEY to call Anthropic directly.
AI_GATEWAY_API_KEY=

# Demo deployment only. DEMO_PRESENTER_KEY is the key of the presenter's own phone
# link (/s/<key>, made in Connect AI); only that link shows "Reset demo", which
# archives every product in the store. STOREFRONT_PASSWORD is the dev store's
# storefront password, shown next to the store link so judges can open it.
# DEMO_TEST_CARD overrides the checkout hint (defaults to Shopify's Bogus Gateway).
DEMO_PRESENTER_KEY=
STOREFRONT_PASSWORD=
DEMO_TEST_CARD=
