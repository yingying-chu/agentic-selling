# Claude API (or run `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=

# Shopify inventory store (Phase 1b): custom app Admin API token
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=

# eBay (Phase 2): developer.ebay.com keyset
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
